{
  "mappings": [
    {
      "name": "GET asorty list",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/asorty$" },
      "response": { "status": 200, "bodyFileName": "asorty-list.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "GET asorty by id",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/asorty/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "asorty-single.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "POST asorty create",
      "request": { "method": "POST", "urlPathPattern": "/[^/]+/asorty$" },
      "response": { "status": 201, "bodyFileName": "created.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT asorty collection update",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/asorty$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT asorty update by id",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/asorty/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "DELETE asorty by id",
      "request": { "method": "DELETE", "urlPathPattern": "/[^/]+/asorty/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    }
  ]
}
