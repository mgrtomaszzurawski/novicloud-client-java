{
  "mappings": [
    {
      "name": "GET towary list",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/towary$" },
      "response": { "status": 200, "bodyFileName": "towary-list.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "GET towary by id",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/towary/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "towary-single.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "POST towary create",
      "request": { "method": "POST", "urlPathPattern": "/[^/]+/towary$" },
      "response": { "status": 201, "bodyFileName": "created.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT towary collection update",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/towary$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT towary update by id",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/towary/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "DELETE towary by id",
      "request": { "method": "DELETE", "urlPathPattern": "/[^/]+/towary/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    }
  ]
}
