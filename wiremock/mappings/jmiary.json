{
  "mappings": [
    {
      "name": "GET jmiary list",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/jmiary$" },
      "response": { "status": 200, "bodyFileName": "jmiary-list.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "GET jmiary by id",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/jmiary/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "jmiary-single.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "POST jmiary create",
      "request": { "method": "POST", "urlPathPattern": "/[^/]+/jmiary$" },
      "response": { "status": 201, "bodyFileName": "created.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT jmiary collection update",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/jmiary$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT jmiary update by id",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/jmiary/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "DELETE jmiary by id",
      "request": { "method": "DELETE", "urlPathPattern": "/[^/]+/jmiary/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    }
  ]
}
