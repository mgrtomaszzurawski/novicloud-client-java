{
  "mappings": [
    {
      "name": "GET waluty list",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/waluty$" },
      "response": { "status": 200, "bodyFileName": "waluty-list.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "GET waluty by id",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/waluty/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "waluty-single.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "POST waluty create",
      "request": { "method": "POST", "urlPathPattern": "/[^/]+/waluty$" },
      "response": { "status": 201, "bodyFileName": "created.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT waluty collection update",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/waluty$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT waluty update by id",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/waluty/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "DELETE waluty by id",
      "request": { "method": "DELETE", "urlPathPattern": "/[^/]+/waluty/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    }
  ]
}
