{
  "mappings": [
    {
      "name": "GET kraje list",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/kraje$" },
      "response": { "status": 200, "bodyFileName": "kraje-list.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "GET kraje by id",
      "request": { "method": "GET", "urlPathPattern": "/[^/]+/kraje/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "kraje-single.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "POST kraje create",
      "request": { "method": "POST", "urlPathPattern": "/[^/]+/kraje$" },
      "response": { "status": 201, "bodyFileName": "created.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT kraje collection update",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/kraje$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "PUT kraje update by id",
      "request": { "method": "PUT", "urlPathPattern": "/[^/]+/kraje/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    },
    {
      "name": "DELETE kraje by id",
      "request": { "method": "DELETE", "urlPathPattern": "/[^/]+/kraje/[^/]+$" },
      "response": { "status": 200, "bodyFileName": "ok.json", "headers": { "Content-Type": "application/json" } }
    }
  ]
}
